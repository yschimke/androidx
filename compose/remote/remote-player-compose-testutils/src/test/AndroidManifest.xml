<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- This module pulls both :compose:test-utils (ComponentActivity themed @style/TestTheme)
             and ui-test-manifest (themed @android:style/Theme.Material.Light.NoActionBar) onto its
             unit-test classpath, so the two library manifests conflict. Pin the ui-test-manifest
             theme and tools:replace it to win the merge, mirroring compose/ui/ui-tooling. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            tools:replace="android:theme" />
    </application>
</manifest>
